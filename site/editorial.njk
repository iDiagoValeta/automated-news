---
layout: base.njk
title: Editorial
description: Notas propias del editor sobre tecnología y oficio.
permalink: "/editorial/index.html"
---
<h1 class="visually-hidden">Editorial</h1>
{% if collections.notas.length %}
  {# Eleventy ordena las colecciones de más antigua a más nueva. Misma
     composición que las noticias: la más nueva destacada, el resto en rejilla. #}
  {% set notas = collections.notas | reverse %}
  <section class="editorial" aria-label="Notas editoriales">
    {% for nota in notas %}
      {% if loop.first %}
        <article class="lead">
          <h2 class="lead__title"><a href="{{ nota.url | url }}">{{ nota.data.title }}</a></h2>
          <p class="lead__summary">{{ nota.data.resumen }}</p>
          <div class="item-pie">
            <p class="source"><time datetime="{{ nota.data.fechaISO }}">{{ nota.data.fechaISO | fechaLarga }}</time><span class="cat">{{ nota.data.tema | tema if nota.data.tema else "Editorial" }}</span></p>
          </div>
        </article>
        {% if notas.length > 1 %}<div class="stories">{% endif %}
      {% else %}
        <article class="story" style="--i: {{ loop.index0 }}">
          <h3 class="story__title"><a href="{{ nota.url | url }}">{{ nota.data.title }}</a></h3>
          <p class="story__summary">{{ nota.data.resumen }}</p>
          <div class="item-pie">
            <p class="source"><time datetime="{{ nota.data.fechaISO }}">{{ nota.data.fechaISO | fechaLarga }}</time><span class="cat">{{ nota.data.tema | tema if nota.data.tema else "Editorial" }}</span></p>
          </div>
        </article>
        {% if loop.last %}</div>{% endif %}
      {% endif %}
    {% endfor %}
  </section>
{% else %}
  <p class="empty">Aún no hay notas editoriales.</p>
{% endif %}
