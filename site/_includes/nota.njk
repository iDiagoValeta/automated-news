---
layout: base.njk
---
<article class="nota">
  <header class="nota__cabecera">
    <p class="kicker">Editorial</p>
    <h1 class="nota__title">{{ title }}</h1>
    <p class="nota__meta">
      <time datetime="{{ fechaISO }}">{{ fechaISO | fechaLarga }}</time>
      <span class="nota__firma">Por {{ site.autor.nombre }}</span>
    </p>
  </header>
  <div class="prosa">{{ content | safe }}</div>
</article>
