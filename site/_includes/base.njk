<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
      // Tema elegido a mano (interruptor): se aplica antes de pintar para no parpadear.
      try {
        var t = localStorage.getItem("tema");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
      // Tipografía elegida (selector de la cabecera): la hoja de Google Fonts
      // solo se pide cuando alguien elige una fuente distinta de la clásica.
      window.FUENTES = {
        fraunces: "Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;600",
        grotesk: "Space+Grotesk:wght@400;600;700",
        plex: "IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;600",
        playfair: "Playfair+Display:wght@700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600"
      };
      window.cargarFuente = function (f) {
        if (!window.FUENTES[f] || document.getElementById("fuente-" + f)) return;
        var l = document.createElement("link");
        l.id = "fuente-" + f;
        l.rel = "stylesheet";
        l.href = "https://fonts.googleapis.com/css2?family=" + window.FUENTES[f] + "&display=swap";
        document.head.appendChild(l);
      };
      try {
        var f = localStorage.getItem("fuente");
        if (window.FUENTES[f]) {
          document.documentElement.dataset.fuente = f;
          window.cargarFuente(f);
        }
      } catch (e) {}
    </script>
    {% set pageTitle = title if title else site.title %}
    {% set pageDesc = description if description else site.descripcion %}
    {% if page.url and page.url != "/" %}
      {% set canon = site.url + page.url %}
    {% else %}
      {% set canon = site.url + "/" %}
    {% endif %}
    {% set ogImage = site.url + "/img/og.png" %}
    <title>{% if title %}{{ title }}, {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ pageDesc | metaDesc }}" />
    <meta name="keywords" content="{{ site.keywords | join(', ') }}" />
    <link rel="canonical" href="{{ canon }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} (RSS)" href="{{ '/feed.xml' | url }}" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }} (Atom)" href="{{ '/atom.xml' | url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{% if title %}{{ title }}, {{ site.title }}{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ pageDesc | metaDesc }}" />
    <meta property="og:url" content="{{ canon }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{% if title %}{{ title }}, {{ site.title }}{% else %}{{ site.title }}{% endif %}" />
    <meta name="twitter:description" content="{{ pageDesc | metaDesc }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />
    <link rel="stylesheet" href="{{ '/css/diario.css' | url }}?v={{ assets.css }}" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23181613'/%3E%3Ctext x='7' y='23' font-family='monospace' font-size='18' fill='%23f2b705'%3E%3E_%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="masthead">
      {% set u = page.url %}
      {% set esBuscar = "/archivo/buscar/" in u %}
      {% set esArchivo = ("/archivo/" in u) and not esBuscar %}
      {% set esRepos = ("/repositorios/" in u) and not esArchivo %}
      {% set esSemana = "/semana/" in u %}
      {% set esNoticias = not esArchivo and not esBuscar and not esRepos and not esSemana %}
      {# El calendario vive en la cabecera: se elige su fuente de fechas según la sección. #}
      {% if esRepos and reposEditions.length %}
        {% set fechas = reposEditions %}
        {% set fechaAttr = "reposPath" %}
        {% set fechaActual = ed.date if ed else reposEditions[0].date %}
      {% elif esNoticias and editions.length and (edition or u == "/") %}
        {% set fechas = editions %}
        {% set fechaAttr = "path" %}
        {% set fechaActual = edition.date if edition else editions[0].date %}
      {% endif %}
      <div class="herramientas">
        {# En móvil, Buscar sale del menú (no cabe) y pasa aquí como icono. #}
        <a class="herramienta herramienta--buscar{% if esBuscar %} is-active{% endif %}" href="{{ '/archivo/buscar/' | url }}"{% if esBuscar %} aria-current="page"{% endif %} data-paleta aria-label="Buscar" title="Buscar">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></g></svg>
        </a>
        {% include "calendario.njk" %}
        <details class="tipo">
          <summary class="herramienta" aria-label="Tipografía" title="Cambiar tipografía">
            <span aria-hidden="true">Aa</span>
          </summary>
          <div class="tipo__panel" role="group" aria-label="Tipografía">
            <button type="button" class="tipo__op" data-fuente="clasica" aria-pressed="true"><span style="font-family: 'Iowan Old Style', Palatino, Georgia, serif">Clásica</span></button>
            <button type="button" class="tipo__op" data-fuente="fraunces" aria-pressed="false"><span style="font-family: Fraunces, Georgia, serif">Fraunces</span></button>
            <button type="button" class="tipo__op" data-fuente="grotesk" aria-pressed="false"><span style="font-family: 'Space Grotesk', system-ui, sans-serif">Grotesca</span></button>
            <button type="button" class="tipo__op" data-fuente="plex" aria-pressed="false"><span style="font-family: 'IBM Plex Mono', ui-monospace, monospace">Terminal</span></button>
            <button type="button" class="tipo__op" data-fuente="playfair" aria-pressed="false"><span style="font-family: 'Playfair Display', Georgia, serif">Editorial</span></button>
          </div>
        </details>
        <button class="tema" type="button" role="switch" aria-checked="false" aria-label="Modo oscuro" title="Cambiar entre modo claro y oscuro" hidden>
          <span class="tema__pista" aria-hidden="true">
            <svg class="tema__ico tema__ico--sol" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
            <svg class="tema__ico tema__ico--luna" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
            <span class="tema__bola"></span>
          </span>
        </button>
      </div>
      <a class="masthead__name" href="{{ '/' | url }}">{{ site.title }}</a>
      <p class="masthead__tagline">{{ site.tagline }}</p>
      <nav class="masthead__nav" aria-label="Secciones">
        <a href="{{ '/' | url }}"{% if esNoticias %} class="is-active" aria-current="page"{% endif %}>Noticias</a>
        <a href="{{ '/repositorios/' | url }}"{% if esRepos %} class="is-active" aria-current="page"{% endif %}>Repositorios</a>
        <a href="{{ '/semana/' | url }}"{% if esSemana %} class="is-active" aria-current="page"{% endif %}>Semana</a>
        <a href="{{ '/archivo/' | url }}"{% if esArchivo %} class="is-active" aria-current="page"{% endif %}>Archivo</a>
        <a class="masthead__buscar{% if esBuscar %} is-active{% endif %}" href="{{ '/archivo/buscar/' | url }}"{% if esBuscar %} aria-current="page"{% endif %} data-paleta aria-keyshortcuts="Control+K Meta+K /">Buscar <kbd>⌘K</kbd></a>
      </nav>
    </header>

    <main id="contenido" class="content">{{ content | safe }}</main>

    <script src="{{ '/js/calendario.js' | url }}?v={{ assets.calendario }}" defer></script>
    <script src="{{ '/js/compartir.js' | url }}?v={{ assets.compartir }}" defer></script>
    <script type="module" src="{{ '/js/paleta.js' | url }}?v={{ assets.paleta }}"></script>
    <script src="{{ '/js/interfaz.js' | url }}?v={{ assets.interfaz }}" defer></script>

    <footer class="pie">
      <a class="pie__marca" href="{{ '/' | url }}">{{ site.title }}</a>
      <p class="pie__credito">Creado por <strong>{{ site.autor.nombre }}</strong></p>
      <p class="pie__enlaces">
        <a href="{{ site.autor.github }}" rel="noopener me" target="_blank">GitHub</a>
        <span class="pie__sep" aria-hidden="true">·</span>
        <a href="{{ site.autor.linkedin }}" rel="noopener me" target="_blank">LinkedIn</a>
        <span class="pie__sep" aria-hidden="true">·</span>
        <a href="{{ '/feed.xml' | url }}">RSS</a>
        <span class="pie__sep" aria-hidden="true">·</span>
        <a href="{{ '/atom.xml' | url }}">Atom</a>
        <span class="pie__sep" aria-hidden="true">·</span>
        <a href="{{ site.repo }}" rel="noopener" target="_blank">Código fuente</a>
      </p>
    </footer>
  </body>
</html>
