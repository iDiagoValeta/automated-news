{# Lista de repositorios hot. Espera `repos` (array) y `fecha` (YYYY-MM-DD).
   Misma anatomía que noticias y lecturas: etiqueta (el lenguaje), título,
   resumen y pie con los metadatos. #}
{% from "share.njk" import share %}
<section class="repos" aria-label="Repositorios hot">
  <div class="stories">
    {% for repo in repos %}
    <article class="story">
      <h2 class="story__title">
        <a href="{{ repo.url }}" target="_blank" rel="noopener" aria-describedby="nueva-pestana">{{ repo.name }}</a>
      </h2>
      <p class="story__summary">{{ repo.description }}</p>
      <div class="item-pie">
        <p class="source">{% if repo.language %}{{ repo.language }}{% endif %}{% if repo.language and repo.stars %}<span class="source__sep" aria-hidden="true"> / </span>{% endif %}{% if repo.stars %}{{ repo.stars | miles }} ★{% endif %}</p>
        {{ share(repo.social, repo.name) }}
      </div>
    </article>
    {% endfor %}
  </div>
</section>
