{# Lista de lecturas. Espera `lecturas` (array). #}
<section class="lecturas" aria-label="Lecturas">
  <ol class="lecturas__lista">
    {% for lectura in lecturas %}
    <li class="lectura">
      <p class="kicker">{{ lectura.tema | tema }}</p>
      <h2 class="lectura__title">
        <a href="{{ lectura.url }}" target="_blank" rel="noopener">{{ lectura.title }}</a>
      </h2>
      <p class="lectura__summary">{{ lectura.summary }}</p>
      <p class="lectura__fuente">{{ lectura.source }}</p>
    </li>
    {% endfor %}
  </ol>
</section>
