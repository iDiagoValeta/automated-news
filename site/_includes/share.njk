{% macro share(social) %}
  {% set s = social | shareModel %}
  {% if s.x or s.linkedin %}
  <div class="share">
    {% if s.x %}
    <a class="share__btn share__intent" href="{{ s.x.href }}" target="_blank" rel="noopener noreferrer" aria-label="Publicar en X">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span>Publicar en X</span>
    </a>
    <button class="share__btn share__copy" type="button" aria-label="Copiar texto para X" data-copy="{{ s.x.text }}">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2V3a1 1 0 011-1h6a1 1 0 011 1v1zm-7 0h6V3H9v1zm-3 4v12h12V8H6z"/></svg>
    </button>
    {% endif %}
    {% if s.linkedin %}
    <a class="share__btn share__intent" href="{{ s.linkedin.href }}" target="_blank" rel="noopener noreferrer" aria-label="Publicar en LinkedIn">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      <span>Publicar en LinkedIn</span>
    </a>
    <button class="share__btn share__copy" type="button" aria-label="Copiar texto para LinkedIn" data-copy="{{ s.linkedin.text }}">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2V3a1 1 0 011-1h6a1 1 0 011 1v1zm-7 0h6V3H9v1zm-3 4v12h12V8H6z"/></svg>
    </button>
    {% endif %}
    <span class="share__ok" role="status">Copiado</span>
  </div>
  {% endif %}
{% endmacro %}
