{% macro share(social) %}
  {% set s = social | shareModel %}
  {% if s.x or s.linkedin %}
  {# Un único botón por tarjeta; las cuatro acciones viven en su menú. #}
  <div class="share">
    <details class="share__menu">
      <summary class="share__btn" aria-label="Compartir" title="Compartir">
        <svg width="15" height="15" aria-hidden="true"><use href="#ico-subir"/></svg>
      </summary>
      <div class="share__panel">
        {% if s.x %}
        <a class="share__item" href="{{ s.x.href }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" aria-hidden="true"><use href="#ico-x"/></svg>
          <span>Publicar en X</span>
        </a>
        <button class="share__item share__copy" type="button" data-red="X" data-copy="{{ s.x.text }}">
          <svg width="15" height="15" aria-hidden="true"><use href="#ico-copiar"/></svg>
          <span>Copiar texto para X</span>
        </button>
        {% endif %}
        {% if s.linkedin %}
        <a class="share__item" href="{{ s.linkedin.href }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" aria-hidden="true"><use href="#ico-linkedin"/></svg>
          <span>Publicar en LinkedIn</span>
        </a>
        <button class="share__item share__copy" type="button" data-red="LinkedIn" data-copy="{{ s.linkedin.text }}">
          <svg width="15" height="15" aria-hidden="true"><use href="#ico-copiar"/></svg>
          <span>Copiar texto para LinkedIn</span>
        </button>
        {% endif %}
      </div>
    </details>
    {# Móvil: el mismo botón abre la hoja de compartir del sistema (compartir.js). #}
    <button class="share__btn share__nativo" type="button" aria-label="Compartir" title="Compartir" data-share-text="{{ s.x.text if s.x else s.linkedin.text }}" hidden>
      <svg width="15" height="15" aria-hidden="true"><use href="#ico-subir"/></svg>
    </button>
  </div>
  {% endif %}
{% endmacro %}
