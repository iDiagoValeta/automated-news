{
  "name": "automated-news",
  "version": "1.0.0",
  "description": "Diario estático de noticias de tecnología en español, publicado cada día en GitHub Pages.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "tech-news",
    "noticias-tecnologia",
    "static-site",
    "github-pages",
    "eleventy",
    "spanish",
    "open-source",
    "news-aggregator",
    "automation",
    "llm"
  ],
  "scripts": {
    "pipeline": "node pipeline/index.ts",
    "build": "eleventy",
    "dev": "eleventy --serve",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  }
}
